{% assign article = closest.article -%}

{% capture children %}
    {% content_for 'blocks', closest.article: article %}
  {% endcapture %}

{% render 'svf-article-card', children: children, article: article, block: block %}

{% schema %}
{
  "name": "Carte article",
  "tag": null,
  "blocks": [
    {
      "type": "image"
    },
    {
      "type": "_article-group"
    },
    {
      "type": "article-date"
    },
    {
      "type": "text"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "checkbox",
      "id": "wrap_in_card",
      "label": "Envelopper dans une carte",
      "default": false
    },
    {
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2",
      "visible_if": "{{ block.settings.wrap_in_card }}",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Aucun"
        },
        {
          "value": "scheme-1",
          "label": "Clair (fond gris clair)"
        },
        {
          "value": "scheme-2",
          "label": "Carte claire (boutons jaunes)"
        },
        {
          "value": "scheme-3",
          "label": "Jaune"
        },
        {
          "value": "scheme-dc39c57a-5dca-4d27-aa18-4454c1b54ee4",
          "label": "Noir"
        },
        {
          "value": "scheme-c103a6b2-823a-4f64-98af-41ea3f4922a8",
          "label": "Blanc (texte blanc)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "layout_gap",
      "label": "Espacement entre les éléments",
      "default": 10,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Aller plus loin"
    },
    {
      "type": "paragraph",
      "content": "❇️ Vous êtes limité par le thème, ou cherchez des solutions d’optimisation concrètes ? [Prenez rendez-vous](https://www.the-deployer.fr/rdv) avec un expert de l’équipe The Deployer !"
    }
  ],
  "presets": [
    {
      "name": "Carte article",
      "category": "Collection",
      "settings": {
        "wrap_in_card": false,
        "color_scheme": "scheme-2",
        "layout_gap": 10
      }
    }
  ]
}
{% endschema %}
