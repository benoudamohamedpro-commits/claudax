{% if additional_checkout_buttons %}
  <div
    class="
      accelerated-checkout accelerated-checkout--full-width
      accelerated-checkout--{{ block.settings.button_style }}
      {%- if block.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
      {%- if block.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
      {%- if block.settings.additional_class != blank %} {{ block.settings.additional_class }}{% endif -%}
    "
    style="--margin-top: {{ block.settings.margin_top }}px; --margin-bottom: {{ block.settings.margin_bottom }}px;"
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-visual-preview-mode
    {% endif %}
  >
    {{ content_for_additional_checkout_buttons }}
  </div>
{% endif %}

{% stylesheet %}
  .svf-panier {
    shopify-visual-preview-block-list .accelerated-checkout[data-visual-preview-mode] {
      width: 400px;
    }
  
    more-payment-options-link {
      font-size: smaller;
    }
  
    more-payment-options-link a {
      --button-color: var(--color-foreground);
    }
  
    more-payment-options-link a:hover {
      opacity: 0.75;
    }
  
    .shopify-payment-button__more-options[aria-hidden='true'] {
      display: none;
    }
  
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Paiement express",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "Afficher sur",
      "default": "desktop_and_mobile",
      "options": [
        {
          "value": "desktop_and_mobile",
          "label": "Ordinateur et mobile"
        },
        {
          "value": "desktop_only",
          "label": "Ordinateur uniquement"
        },
        {
          "value": "mobile_only",
          "label": "Mobile uniquement"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        {
          "value": "primary",
          "label": "Primaire"
        },
        {
          "value": "secondary",
          "label": "Secondaire"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Marge en haut",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Marge en bas",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Réglages avancés"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "Classes CSS supplémentaires",
      "info": "Utiles pour réaliser des A/B tests par exemple. Pour ajouter plusieurs classes, séparez-les par un espace."
    },
    {
      "type": "header",
      "content": "Aller plus loin"
    },
    {
      "type": "paragraph",
      "content": "❇️ Vous êtes limité par le thème, ou cherchez des solutions d’optimisation concrètes ? [Prenez rendez-vous](https://www.the-deployer.fr/rdv) avec un expert de l’équipe The Deployer !"
    }
  ],
  "presets": [
    {
      "name": "Bouton de paiement rapide",
      "category": "Formulaire de produit"
    }
  ]
}
{% endschema %}
