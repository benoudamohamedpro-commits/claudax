      "info": "Variable: Si vous utilisez le caractère #, il sera remplacé par le montant manquant."
    },
    {
      "type": "number",
      "id": "step2_value",
      "label": "Palier atteint si supérieur ou égal à",
      "info": "Montant du panier (€)",
      "visible_if": "{{ block.settings.progress_bar_based_on == 'value' }}"
    },
    {
      "type": "number",
      "id": "step2_quantity",
      "label": "Palier atteint si supérieur ou égal à",
      "visible_if": "{{ block.settings.progress_bar_based_on == 'quantity' }}"
    },
    {
      "type": "text",
      "id": "step2_label",
      "label": "Mention en dessous du palier"
    },
    {
      "type": "paragraph",
      "content": "Pour ajouter un cadeau au panier lorsque le palier est atteint, consultez le [guide](https://hub.themefullstack.com/training-center/master-theme-fullstack/auto-gifts)."
    },
    {
      "type": "header",
      "content": "Palier 3"
    },
    {
