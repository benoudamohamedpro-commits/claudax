<div
  class="svf-tiroir-empty-blocks{% if block.settings.wrap_in_card %} svf-card color-{{ block.settings.color_scheme }}{% endif %}"
  style="--margin-top: {{ block.settings.margin_top }}px; --margin-bottom: {{ block.settings.margin_bottom }}px;"
>
  {% if block.settings.show_continue_shopping_button %}
    <button onclick="this.closest('svf-tiroir').close()" class="button">
      Continuer les achats
    </button>
  {% endif %}

  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .svf-panier {
    .svf-tiroir-empty-blocks {
      margin-top: var(--margin-top);
      margin-bottom: var(--margin-bottom);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 2rem;
      width: 100%;
    }
  
    @media (width <= 750px) {
      .svf-tiroir-empty-blocks .slider-component--65-percent .splide__list {
        width: calc(100vw - 50%);
      }
    }
  
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tiroir : panier vide",
  "tag": null,
  "blocks": [
    {
      "type": "text"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_continue_shopping_button",
      "label": "Afficher le bouton Continuer les achats",
      "default": true
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "checkbox",
      "id": "wrap_in_card",
      "label": "Envelopper dans une carte",
      "default": false
    },
    {
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2",
      "visible_if": "{{ block.settings.wrap_in_card }}",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Aucun"
        },
        {
          "value": "scheme-1",
          "label": "Clair (fond gris clair)"
        },
        {
          "value": "scheme-2",
          "label": "Carte claire (boutons jaunes)"
        },
        {
          "value": "scheme-3",
          "label": "Jaune"
        },
        {
          "value": "scheme-dc39c57a-5dca-4d27-aa18-4454c1b54ee4",
          "label": "Noir"
        },
        {
          "value": "scheme-c103a6b2-823a-4f64-98af-41ea3f4922a8",
          "label": "Blanc (texte blanc)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Marge en haut",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Marge en bas",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Panier vide"
    }
  ]
}
{% endschema %}
