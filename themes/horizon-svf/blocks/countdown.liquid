    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "date_end",
      "label": "Date et heure de fin",
      "default": "01/01/2028 00:00",
      "info": "Exemple de format : DD/MM/YYYY HH:MM. L'heure utilisée est l'heure locale du visiteur (celle de son navigateur web)."
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "Afficher les jours",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Afficher les heures",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_minutes",
      "label": "Afficher les minutes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Afficher les secondes",
      "default": true
    },
    {
      "type": "select",
      "id": "ended_timer_style",
      "label": "Style de l'affichage lorsque le compte à rebours est écoulé",
      "options": [
        {
          "value": "message",
          "label": "Afficher un message"
        },
        {
          "value": "hide_timer",
          "label": "Masquer le timer"
        }
      ],
      "default": "hide_timer"
    },
    {
      "type": "text",
      "id": "timer_ended_text",
      "label": "Texte à afficher lorsque le compte à rebours est écoulé",
      "default": "L'offre est terminée",
      "visible_if": "{{ block.settings.ended_timer_style == 'message' }}"
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Marge en haut",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Marge en bas",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Réglages avancés"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "Classes CSS supplémentaires",
      "info": "Utiles pour réaliser des A/B tests par exemple. Pour ajouter plusieurs classes, séparez-les par un espace."
    },
    {
      "type": "header",
      "content": "Aller plus loin"
