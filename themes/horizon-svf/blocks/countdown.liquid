      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "timer_font_weight",
      "label": "Épaisseur de la police",
      "min": 400,
      "max": 600,
      "step": 100,
      "default": 500
    },
    {
      "type": "select",
      "id": "timer_style",
      "label": "Style du timer",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "background",
          "label": "Arrière-plan"
        },
        {
          "value": "border",
          "label": "Bordure de séparation"
        }
      ],
      "default": "normal"
