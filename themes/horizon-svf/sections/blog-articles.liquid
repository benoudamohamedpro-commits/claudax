<div
  class="main-blog color-{{ section.settings.color_scheme }}"
  style="--margin-top: {{ section.settings.margin_top }}px; --margin-bottom: {{ section.settings.margin_bottom }}px;"
>
  <div
    class="main-blog__articles page-width"
    style="
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {% paginate blog.articles by 10 %}
      <div
        class="main-blog__articles-grid"
        style="
          --grid-columns: {{ section.settings.grid_columns }};
          --grid-columns-mobile: {{ section.settings.grid_columns_mobile }};
        "
      >
        {% if blog.articles.size > 0 %}
          {% for article in blog.articles %}
            {% content_for 'block', type: '_article-card', id: 'article-card', closest.article: article %}
          {% endfor %}
        {% else %}
          <p class="main-blog__empty">Aucun article trouvé</p>
        {% endif %}
      </div>

      {%- if paginate.pages > 1 -%}
        {% render 'svf-pagination', paginate_object: paginate %}
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .main-blog {
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
  }

  .main-blog__articles {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .main-blog__articles-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-mobile), 1fr);
    gap: 2rem;
  }

  @media (width > 750px) {
    .main-blog__articles-grid {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Articles du blog",
  "enabled_on": {
    "templates": [
      "blog"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Aucun"
        },
        {
          "value": "scheme-1",
          "label": "Clair (fond gris clair)"
        },
        {
          "value": "scheme-2",
          "label": "Carte claire (boutons jaunes)"
        },
        {
          "value": "scheme-3",
          "label": "Jaune"
        },
        {
          "value": "scheme-dc39c57a-5dca-4d27-aa18-4454c1b54ee4",
          "label": "Noir"
        },
        {
          "value": "scheme-c103a6b2-823a-4f64-98af-41ea3f4922a8",
          "label": "Blanc (texte blanc)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Apparence sur ordinateur"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Nombre de colonnes",
      "default": 3,
      "min": 2,
      "max": 4,
      "step": 1
    },
    {
      "type": "header",
      "content": "Apparence sur mobile"
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Nombre de colonnes",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Espacements internes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge interne en haut",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge interne en bas",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "header",
      "content": "Marges"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Marge en haut",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Marge en bas",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "header",
      "content": "Aller plus loin"
    },
    {
      "type": "paragraph",
      "content": "❇️ Vous êtes limité par le thème, ou cherchez des solutions d’optimisation concrètes ? [Prenez rendez-vous](https://www.the-deployer.fr/rdv) avec un expert de l’équipe The Deployer !"
    }
  ]
}
{% endschema %}
