<script src="{{ 'svf-cart.js' | asset_url }}" type="module"></script>
<script src="{{ 'svf-quantity-selector.js' | asset_url }}" type="module"></script>
<script src="{{ 'svf-toast-notification.js' | asset_url }}" type="module"></script>

<div class="svf-panier">
  {% render 'svf-toast-notification' %}

<cart-component class="cart color-{{ section.settings.color_scheme }}">
  <div
    class="cart__inner page-width"
    style="
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="cart__header">
      <h1 class="h3">
        Panier
        {%- if section.settings.show_cart_count %} ({{ cart.item_count }}){%- endif -%}
      </h1>

      {% content_for 'block', type: '_cart-header-blocks', id: 'cart_header_blocks' %}
    </div>

    <div class="cart__content">
      <form class="cart__form" data-ref="cart-form" action="{{ routes.cart_url }}" method="post" id="cart_form">
        {% if cart.empty? %}
          <div class="cart__empty svf-card">
            <p class="h6">Votre panier est vide</p>

            <a href="{{ routes.root_url }}" class="button">
              Continuer les achats
            </a>
          </div>
        {% else %}
          <div class="cart__items">
            {% for item in cart.items %}
              {%- if item.parent_relationship -%}
                {%- continue -%}
              {%- endif -%}

              {%- assign is_gift = false -%}
              {%- if item.properties._is_gift == 'true' -%}
                {%- assign is_gift = true -%}
              {%- endif -%}

              {%- assign can_remove = true -%}
              {%- if item.instructions and item.instructions.can_remove == false -%}
                {%- assign can_remove = false -%}
              {%- endif -%}

              {%- assign can_update_quantity = true -%}
              {%- if item.instructions and item.instructions.can_update_quantity == false -%}
                {%- assign can_update_quantity = false -%}
              {%- endif -%}

              <cart-item
                data-index="{{ item.index | plus: 1 }}"
                class="cart__item svf-card svf-card--with-border{% if section.settings.show_remove_button == false %} cart__item--no-remove-button{% endif %}{% if is_gift %} cart__item--gift{% endif %}"
                data-ref="cart-item"
                data-product-handle="{{ item.product.handle }}"
                data-quantity="{{ item.quantity }}"
                {% if is_gift %}
                  data-is-gift="true"
                {% endif %}
                style="--product-image-ratio: {{ section.settings.products_media_ratio }};"
              >
                {%- capture item_image -%}
                  {% if item.image %}
                    <img
                      src="{{ item.image | image_url: width: 150 }}"
                      alt="{{ item.product.title | default: item.product.title }}"
                      loading="lazy"
                      width="85"
                      height="{{ 85 | divided_by: item.image.aspect_ratio | ceil }}"
                    >
                  {% else %}
                    <img
                      src="{{ 'svf-placeholder-image.jpg' | asset_url }}"
                      alt="placeholder product"
                      width="85"
                      height="85"
                    >
                  {% endif %}
                {%- endcapture -%}

                {% if is_gift %}
                  <span class="cart__item-image">{{ item_image }}</span>
                {% else %}
                  <a href="{{ item.url }}">{{ item_image }}</a>
                {% endif %}

                <div class="cart__item-wrapper">
                  <div class="cart__item-content">
                    {%- capture item_name -%}
                      {{- item.product.title | escape -}}
                    {%- endcapture -%}

                    {% if is_gift %}
                      <span class="cart__item-name cart__item-name--gift">{{ item_name }}</span>
                    {% else %}
                      <a href="{{ item.url }}" class="cart__item-name">{{ item_name }}</a>
                    {% endif %}

                    <div class="cart__item-prices">
                      <div class="cart__item-price">
                        {% assign compare_price = item.original_price %}
                        {% if item.variant.compare_at_price > item.original_price %}
                          {% assign compare_price = item.variant.compare_at_price %}
                        {% endif %}

                        {%- if compare_price > item.final_price -%}
                          {% render 'svf-price', price: item.final_price, compare_price: compare_price, sales_badge: 'none' %}
                        {%- else -%}
                          {% render 'svf-price', price: item.final_price, sales_badge: 'none' %}
                        {%- endif -%}

                        {% comment %}
                          Ancienne version qui fait le total de la ligne au lieu du prix unitaire :

                          {% assign compare_price = item.original_price %}
                          {% if item.variant.compare_at_price > item.original_price %}
                            {% assign compare_price = item.variant.compare_at_price | times: item.quantity %}
                          {% endif %}

                          {%- if compare_price > item.final_line_price -%}
                            {% render 'svf-price', price: item.final_line_price, compare_price: compare_price, sales_badge: 'none' %}
                          {%- else -%}
                            {% render 'svf-price', price: item.final_line_price, sales_badge: 'none' %}
                          {%- endif -%}
                        {% endcomment %}

                        <div class="cart__item-discounts">
                          {%- if item.properties._gift_badge != blank -%}
                            <span class="cart__item-discount badge badge--secondary badge--small">
                              {% render 'svf-icon', icon: 'featured_seasonal_and_gifts' %}
                              <span>{{ item.properties._gift_badge }}</span>
                            </span>
                          {%- endif -%}
                          {%- for discount in item.line_level_discount_allocations -%}
                            <span class="cart__item-discount badge badge--secondary badge--small">
                              {% render 'svf-icon', icon: 'shoppingmode' %}
                              <span>{{ discount.discount_application.title }}</span>
                            </span>
                          {%- endfor -%}
                        </div>
                      </div>
                    </div>

                    {% liquid
                      assign children_count = 0
                      assign has_bundle_components = false

                      if item.item_components.size > 0
                        assign has_bundle_components = true
                        assign children_count = item.item_components.size
                      else
                        for other in cart.items
                          if other.parent_relationship.parent.key == item.key
                            assign children_count = children_count | plus: 1
                          endif
                        endfor
                      endif
                    %}

                    {% if children_count > 0 %}
                      {% render 'svf-cart-line-children', item: item, children_count: children_count, has_bundle_components: has_bundle_components %}
                    {% else %}
                      {%- if item.product.has_only_default_variant == false -%}
                        <div class="cart__item-options">
                          {%- for option in item.options_with_values -%}
                            {%- if section.settings.show_variant_options_labels == false -%}
                              <span>
                                {{- option.value -}}
                                {%- unless forloop.last %}, {% endunless -%}
                              </span>
                            {%- else -%}
                              <div class="cart__item-option">
                                <span>{{ option.name }} :</span>
                                <span>{{ option.value -}}</span>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    {% endif %}

                    {%- for property in item.properties -%}
                      {%- if forloop.first -%}
                        <div class="cart__item-options">
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="cart-drawer__item-option">
                                <span>{{ property.first }} :</span>
                                <span>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" target="_blank">
                                      {{- property.last | split: '/' | last -}}
                                    </a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </span>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- if item.selling_plan_allocation.selling_plan != blank -%}
                      <div class="cart__item-options">
                        <p class="cart__item-option">
                          {{ item.selling_plan_allocation.selling_plan.name }}
                        </p>
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="cart__item-actions">
                    <div class="cart__item-actions-wrapper">
                      {%- if section.settings.show_remove_button and can_remove -%}
                        {% assign data_variant_id = 'data-variant-id="' | append: item.variant.id | append: '"' %}
                        {% assign data_ref = 'data-ref="remove-item"' %}
                        {% assign data = data_variant_id | append: data_ref %}

                        <button type="button" class="button button--secondary button--small button--icon-only" aria-label="Supprimer" {{ data }}>{% render 'svf-icon', icon: 'delete' %}</button>
                      {%- endif -%}

                      {%- if can_update_quantity and is_gift == false -%}
                        {% assign data_ref = 'data-ref="quantity-selector-input"' %}
                        {% assign data_buttons = 'data-ref="quantity-selector-button"' %}

                        {% assign max_quantity = item.variant.inventory_quantity %}
                        {% if item.variant.inventory_policy == 'continue' %}
                          {% assign max_quantity = 0 %}
                        {% endif %}

                        {% render 'svf-quantity-selector',
                          small: true,
                          name: 'updates[]',
                          value: item.quantity,
                          min: -1,
                          max: max_quantity,
                          data_input: data_ref,
                          data_buttons: data_buttons
                        %}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </cart-item>
            {% endfor %}
          </div>
        {% endif %}

        <div class="cart__footer svf-card svf-card--with-border">
          {% content_for 'block', type: '_cart-footer-resume-blocks', id: 'cart_footer_resume_blocks' %}

          <div class="cart__ctas">
            <button
              type="submit"
              data-ref="checkout-button"
              class="button button--full-width"
              name="checkout"
              form="cart_form"
              {% if cart == empty %}
                disabled
              {% endif %}
            >
              <span>Commander</span>
              {% render 'svf-loading-spinner' %}
            </button>
          </div>

          {% content_for 'block', type: '_cart-footer-blocks', id: 'cart_footer_blocks' %}
        </div>
      </form>
    </div>
  </div>
</cart-component>
</div>

{% stylesheet %}
  .svf-panier {
    .cart {
      display: block;
    }
  
    .cart__inner {
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
    }
  
    & {
      --cart-item-image-width: 85px;
    }
  
    .cart__empty {
      border: 1px solid var(--color-border);
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }
  
    .cart {
      padding-bottom: 3rem;
    }
  
    .cart__header {
      padding: 1rem 0;
    }
  
    .cart__form {
      display: grid;
      grid-template-columns: 100%;
      gap: 1rem;
    }
  
    .cart__form--loading {
      opacity: 0.5;
      pointer-events: none;
    }
  
    @media (width > 750px) {
      .cart__header {
        padding: 2rem 0;
      }
  
      .cart__form {
        grid-template-columns: 60% calc(40% - 2rem);
        gap: 2rem;
      }
    }
  
    .cart__items {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
  
    .cart__footer {
      height: fit-content;
    }
  
    .cart__footer > *:not(:last-child) {
      margin-bottom: 0.75rem;
    }
  
    .cart__footer .accordion__content,
    .cart__footer .accordion__header {
      padding: 0.33rem 0;
    }
  
    /* Totals */
  
    .cart__totals,
    .cart__reductions {
      display: flex;
      justify-content: center;
      align-items: center;
      justify-content: space-between;
    }
  
    .cart__totals > * {
      color: rgb(var(--color-foreground));
      margin: 0;
      line-height: 1;
    }
  
    .cart__reductions p,
    .cart__totals p {
      font-weight: 500;
      margin: 0;
      line-height: normal;
    }
  
    .cart__reductions p,
    .cart__totals p,
    .cart__reductions-value,
    .cart__totals-value {
      font-size: var(--svf-font-size-emphasized);
    }
  
    /* CTAs */
  
    .cart__ctas {
      text-align: center;
      display: flex;
      gap: 10px;
      margin-bottom: 0;
    }
  
    .cart__ctas button {
      width: 100%;
    }
  
    /* Item */
  
    .cart__item {
      background-color: var(--color-background);
      color: var(--color-foreground);
      display: flex;
      gap: 0.5rem;
      align-items: flex-start;
      max-width: 100%;
    }
  
    .cart__item > a {
      display: flex;
      align-items: center;
    }
  
    .cart__item img {
      width: var(--cart-item-image-width);
      object-fit: cover;
      aspect-ratio: var(--product-image-ratio);
      background-color: white;
      max-width: fit-content;
      border-radius: calc(16px - 0.75rem);
    }
  
    .cart__item.svf-card {
      padding: 0.75rem;
  
      img {
        border-radius: calc(16px - 0.75rem);
      }
    }
  
    .cart__item-options {
      line-height: normal;
      font-size: 0.78125rem;
      word-break: break-word;
      color: rgba(var(--color-foreground), 0.8);
    }
  
    .cart__item-options .cart__item-option:not(:last-child) {
      margin-bottom: 0.5rem;
    }
  
    .cart__item-option {
      margin: 0;
    }
  
    .cart__item-content {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-top: 5px;
    }
  
    .cart__item-wrapper {
      display: flex;
      justify-content: space-between;
      width: 100%;
      min-height: var(--cart-item-image-width);
      gap: 0.5rem;
    }
  
    .cart__item-name {
      text-decoration: none;
      display: block;
      width: calc(100% + 60px);
      font-size: 0.875rem;
      color: rgb(var(--color-foreground));
      font-weight: 500;
      line-height: normal;
      margin-bottom: 0;
      transition: var(--animation-link-hover);
  
      &:hover {
        opacity: 0.75;
      }
    }
  
    .cart__item-name--gift {
      cursor: default;
    }
  
    .cart__item-name--gift:hover {
      opacity: 1;
    }
  
    .cart__item-image {
      display: flex;
      align-items: center;
    }
  
    .cart__item-prices {
      position: relative;
      width: 100%;
    }
  
    .cart__item-prices.loading {
      width: max-content;
    }
  
    .cart__item-price {
      display: flex;
      align-items: center;
      gap: 0.33rem;
      flex-wrap: wrap;
      font-size: 0.78125rem;
      color: rgb(var(--color-foreground));
    }
  
    .cart__item-price > * {
      display: block;
      margin: 0;
      padding: 0;
      line-height: normal;
    }
  
    .cart__item-discounted-prices {
      display: flex;
      align-self: center;
      gap: 6px;
      line-height: normal;
    }
  
    .cart__item-compare-price {
      opacity: 0.7;
    }
  
    .cart__item--no-remove-button .cart__item-actions-wrapper {
      justify-content: flex-end;
    }
  
    .cart__item--no-remove-button .cart__item-name {
      width: calc(100% + var(--cart-item-image-width));
    }
  
    @media screen and (max-width: 350px) {
      .cart__item--no-remove-button .cart__item-name {
        width: calc(100% + 75px);
      }
    }
  
    @media screen and (max-width: 350px) {
      .cart__item img {
        width: var(--cart-item-image-width);
        max-height: calc(var(--cart-item-image-width) * 1.2);
      }
  
      .cart__item-content {
        gap: 5px;
      }
  
      .cart__item-wrapper {
        min-height: calc(var(--cart-item-image-width) * 1.2);
      }
      .cart__item-name {
        width: calc(100% + 50px);
      }
  
      .cart__item-prices {
        width: 100%;
      }
    }
  
    /* Quantity & Remove Button */
  
    .cart__item-actions {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
  
    .cart__item-actions-wrapper {
      display: flex;
      align-items: flex-end;
      flex-direction: column;
      height: 100%;
      gap: 1rem;
    }
  
    .cart__item-actions-wrapper .button,
    .cart__item-actions-wrapper .svf-qte {
      border: 1px solid var(--color-border);
    }
  
    @media screen and (max-width: 749px) {
      .cart__item-actions-wrapper {
        flex-wrap: wrap;
      }
    }
  
    /* Discounts */
  
    .cart__discounts {
      margin-bottom: 0;
    }
  
    .cart__discount {
      margin-bottom: 0.75rem;
    }
  
    .cart__item-discounts,
    .cart__discounts {
      font-size: 12px;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
  
    .cart__item-discount,
    .cart__discount {
      min-width: max-content;
      gap: 0.33rem;
    }
  
    .icon-discount {
      color: rgb(var(--color-foreground));
      width: 12px;
      height: 12px;
      margin-right: 7px;
    }
  
    @media screen and (max-width: 750px) {
      .cart__item-discount span {
        max-width: 70px;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
      }
  
      .cart__discounts {
        overflow: scroll;
        flex-wrap: nowrap;
      }
  
      .cart__discounts::-webkit-scrollbar {
        height: 3px;
      }
    }
  
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panier (origine)",
  "settings": [
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1",
      "type": "select",
      "options": [
        {
          "value": "",
          "label": "Aucun"
        },
        {
          "value": "scheme-1",
          "label": "Clair (fond gris clair)"
        },
        {
          "value": "scheme-2",
          "label": "Carte claire (boutons jaunes)"
        },
        {
          "value": "scheme-3",
          "label": "Jaune"
        },
        {
          "value": "scheme-dc39c57a-5dca-4d27-aa18-4454c1b54ee4",
          "label": "Noir"
        },
        {
          "value": "scheme-c103a6b2-823a-4f64-98af-41ea3f4922a8",
          "label": "Blanc (texte blanc)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "select",
      "id": "products_media_ratio",
      "label": "Ratio des images produit",
      "options": [
        {
          "value": "1 / 1",
          "label": "Carré"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "4 / 3",
          "label": "Paysage"
        },
        {
          "value": "adapt",
          "label": "S'adapte au média"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_variant_options_labels",
      "label": "Afficher les labels de variantes",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_remove_button",
      "label": "Afficher le bouton de suppression de produit",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "Afficher le nombre d'articles dans le panier",
      "default": true
    },
    {
      "type": "header",
      "content": "Espacements internes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge interne en haut",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge interne en bas",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "header",
      "content": "Aller plus loin"
    },
    {
      "type": "paragraph",
      "content": "❇️ Vous êtes limité par le thème, ou cherchez des solutions d’optimisation concrètes ? [Prenez rendez-vous](https://www.the-deployer.fr/rdv) avec un expert de l’équipe The Deployer !"
    }
  ],
  "enabled_on": {
    "templates": [
      "cart"
    ]
  }
}
{% endschema %}
