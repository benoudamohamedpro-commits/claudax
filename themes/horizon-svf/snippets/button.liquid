{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
    {% if block_settings.size != blank %} svf-button svf-button--{{ block_settings.size }}{% endif %}
    {% if block_settings.show_on == 'desktop' %} svf-desktop-only{% elsif block_settings.show_on == 'mobile' %} svf-mobile-only{% endif %}
    {{ block_settings.custom_class }}
  "
  style="{% render 'size-style', settings: block_settings %}{% if block_settings.margin_top != blank %} --svf-margin-top: {{ block_settings.margin_top }}px;{% endif %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {%- if block_settings.icon != blank and block_settings.icon != 'none' and block_settings.icon_position == 'start' -%}
    {% render 'svf-icon', icon: block_settings.icon %}
  {%- endif -%}
  {{ block_settings.label }}
  {%- if block_settings.icon != blank and block_settings.icon != 'none' and block_settings.icon_position != 'start' -%}
    {% render 'svf-icon', icon: block_settings.icon %}
  {%- endif -%}
</a>
