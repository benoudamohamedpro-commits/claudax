{% doc %}
  Affiche un champ de saisie.

  @param {string} name - Nom du champ
  @param {string} [id] - Id du champ
  @param {string} [value] - Valeur du champ
  @param {boolean} [disabled] - Indique si le champ est désactivé
  @param {string} [placeholder] - Placeholder du champ
  @param {string} [data] - Données du champ
  @param {boolean} [full_width] - Indique si le champ doit prendre toute la largeur

  @example
  {% render 'textarea', name: 'textarea-1' %}
{% enddoc %}

{% assign style_class = 'textarea' %}

{% if disabled %}
  {% assign style_class = style_class | append: ' textarea--disabled' %}
{% endif %}

{% if full_width %}
  {% assign style_class = style_class | append: ' textarea--full-width' %}
{% endif %}

<div class="{{ style_class }}">
  <textarea
    name="{{ name }}"
    id="{{ id | default: name }}"
    {% if disabled %}
      disabled
    {% endif %}
    {% if placeholder %}
      placeholder="{{ placeholder }}"
    {% endif %}
    {% if value %}
      value="{{ value }}"
    {% endif %}
    {% if data %}
      {{ data }}
    {% endif %}
  >
    {%- if value -%}
      {{ value }}
    {%- endif -%}
  </textarea>
</div>

{% stylesheet %}
  .textarea {
    position: relative;
  }

  .textarea textarea {
    outline: none;
    border: 1px solid var(--color-input-border);
    border-radius: 10px;
    padding: 14px;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    transition: 0.1s ease-out;
    height: calc(50px * 2);
    width: 100%;
    font-size: 0.875rem;
  }

  .textarea--disabled textarea {
    opacity: 0.5;
    cursor: not-allowed;
    background-color: var(--color-input-background);
  }

  .textarea--full-width textarea {
    width: 100%;
  }
{% endstylesheet %}
