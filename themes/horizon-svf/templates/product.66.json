    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.4s ease;\n    filter: brightness(0.92);\n  }\n\n  .svf-ugc__item:hover img {\n    transform: scale(1.04);\n    filter: brightness(1);\n  }\n\n  .svf-ugc__item::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    border: 2px solid transparent;\n    border-radius: 4px;\n    transition: border-color 0.3s;\n  }\n\n  .svf-ugc__item:hover::after {\n    border-color: #fbcb05;\n  }\n\n  @keyframes svf-scroll {\n    0%   { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .svf-ugc__track {\n      animation: none;\n    }\n    .svf-ugc__track-wrapper {\n      overflow-x: auto;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .svf-ugc {\n      padding: 40px 0;\n    }\n\n    .svf-ugc__item {\n      width: 220px;\n      height: 220px;\n    }\n\n    .svf-ugc__track-wrapper::before,\n    .svf-ugc__track-wrapper::after {\n      width: 60px;\n    }\n\n    .svf-ugc__track {\n      animation-duration: 27s;\n    }\n  }\n</style>\n\n<div class=\"svf-ugc\">\n\n  <div class=\"svf-ugc__header\">\n    <h2 class=\"svf-ugc__title\">Ils se sont <em>&eacute;quip&eacute;s</em></h2>\n  </div>\n\n  <div class=\"svf-ugc__track-wrapper\">\n    <div class=\"svf-ugc__track\">\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/0365fe4e-2924-4bad-90a5-b1ce575fd0e8.webp?v=1780967183\" alt=\"Vélo noir équipé d'une sacoche latérale jaune\" width=\"280\" height=\"280\" loading=\"eager\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/A271ad4f5b8f74e62bbc63e3568a33aacm_jpg_960x960q75_jpg.webp?v=1786337793\" alt=\"Vélo équipé d'une sacoche de bikepacking\" width=\"280\" height=\"280\" loading=\"eager\" decoding=\"async\">\n      </div>\n\n      <