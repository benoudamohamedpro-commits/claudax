    "custom_code_XJtYH9": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,700;1,700&family=Syne:wght@700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .svf-ugc {\n    background: #252525;\n    padding: 56px 0;\n    overflow: hidden;\n  }\n\n  .svf-ugc__header {\n    text-align: left;\n    margin-bottom: 36px;\n    padding: 0 40px;\n  }\n\n  .svf-ugc__eyebrow {\n    font-family: 'Syne', 'Arial Black', sans-serif;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #fbcb05;\n    margin-bottom: 10px;\n  }\n\n  .svf-ugc__title {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: clamp(28px, 4vw, 44px);\n    line-height: 1.1;\n    color: #ffffff;\n    letter-spacing: -0.02em;\n  }\n\n  .svf-ugc__title em {\n    font-style: normal;\n    color: #fbcb05;\n  }\n\n  .svf-ugc__track-wrapper {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n  }\n\n  .svf-ugc__track-wrapper::before,\n  .svf-ugc__track-wrapper::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    width: 120px;\n    height: 100%;\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  .svf-ugc__track-wrapper::before {\n    left: 0;\n    background: linear-gradient(to right, #252525 0%, transparent 100%);\n  }\n\n  .svf-ugc__track-wrapper::after {\n    right: 0;\n    background: linear-gradient(to left, #252525 0%, transparent 100%);\n  }\n\n  .svf-ugc__track {\n    display: flex;\n    gap: 16px;\n    width: max-content;\n    animation: svf-scroll 38s linear infinite;\n  }\n\n  .svf-ugc__track:hover {\n    animation-play-state: paused;\n  }\n\n  .svf-ugc__item {\n    width: 280px;\n    height: 280px;\n    border-radius: 4px;\n    overflow: hidden;\n    flex-shrink: 0;\n    position: relative;\n  }\n\n  .svf-ugc__item img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.4s ease;\n    filter: brightness(0.92);\n  }\n\n  .svf-ugc__item:hover img {\n    transform: scale(1.04);\n    filter: brightness(1);\n  }\n\n  .svf-ugc__item::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    border: 2px solid transparent;\n    border-radius: 4px;\n    transition: border-color 0.3s;\n  }\n\n  .svf-ugc__item:hover::after {\n    border-color: #fbcb05;\n  }\n\n  @keyframes svf-scroll {\n    0%   { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .svf-ugc__track {\n      animation: none;\n    }\n    .svf-ugc__track-wrapper {\n      overflow-x: auto;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .svf-ugc {\n      padding: 40px 0;\n    }\n\n    .svf-ugc__item {\n      width: 220px;\n      height: 220px;\n    }\n\n    .svf-ugc__track-wrapper::before,\n    .svf-ugc__track-wrapper::after {\n      width: 60px;\n    }\n\n    .svf-ugc__track {\n      animation-duration: 27s;\n    }\n  }\n</style>\n\n<div class=\"svf-ugc\">\n\n  <div class=\"svf-ugc__header\">\n    <h2 class=\"svf-ugc__title\">Ils se sont <em>&eacute;quip&eacute;s</em></h2>\n  </div>\n\n  <div class=\"svf-ugc__track-wrapper\">\n    <div class=\"svf-ugc__track\">\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/0365fe4e-2924-4bad-90a5-b1ce575fd0e8.webp?v=1780967183\" alt=\"Vélo noir équipé d'une sacoche latérale jaune\" width=\"280\" height=\"280\" loading=\"eager\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/A271ad4f5b8f74e62bbc63e3568a33aacm_jpg_960x960q75_jpg.webp?v=1786337793\" alt=\"Vélo équipé d'une sacoche de bikepacking\" width=\"280\" height=\"280\" loading=\"eager\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/S75d128e3fcad448391c2dbbf4c5eca81s_jpg_960x960q75_jpg.webp?v=1778003230\" alt=\"Sacoche fixée sur la fourche avant du vélo\" width=\"280\" height=\"280\" loading=\"eager\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/Ab0048275c1f04548bee997fc4c1d20ce3_jpg_960x960q75_jpg.webp?v=1778003230\" alt=\"Vélo équipé d'une sacoche de transport\" width=\"280\" height=\"280\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/image_75419c8b-a6e9-4f34-be6d-65dc62716aed.webp?v=1786143304\" alt=\"Sacoche de vélo installée sur le cadre\" width=\"280\" height=\"280\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/Sbaaf3462ece340749f7168d0f94b8aecT_jpg_960x960q75_jpg.webp?v=1778003230\" alt=\"Vélo avec sacoche stationné en intérieur\" width=\"280\" height=\"280\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/Ab3b1e5c9da1346a68a0b7364e79040d0D_jpg_960x960q75_jpg.webp?v=1778003155\" alt=\"Sacoche de selle noire sur vélo de route\" width=\"280\" height=\"280\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/image_20.webp?v=1785981520\" alt=\"Vélo chargé pour une sortie bikepacking\" width=\"280\" height=\"280\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"svf-ugc__item\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1007/4338/1379/files/0365fe4e-2924-4bad-90a5-b1ce575fd0e8.webp?v=17809671