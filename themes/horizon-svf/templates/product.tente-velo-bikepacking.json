    "custom_code_M7r7wp": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% comment %} Section : Bande défilante marques vélo — logos en fichiers WebP (assets du thème) {% endcomment %}\n\n<style>\n  .brands-ticker {\n    background: #f6f6f6;\n    padding: 36px 0 28px;\n    text-align: center;\n    overflow: hidden;\n  }\n\n  .brands-ticker__label {\n    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: #999;\n    margin-bottom: 28px;\n  }\n\n  .brands-ticker__track-wrapper {\n    overflow: hidden;\n    position: relative;\n    width: 100%;\n  }\n\n  .brands-ticker__track-wrapper::before,\n  .brands-ticker__track-wrapper::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    width: 100px;\n    height: 100%;\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  .brands-ticker__track-wrapper::before {\n    left: 0;\n    background: linear-gradient(to right, #f6f6f6 0%, transparent 100%);\n  }\n\n  .brands-ticker__track-wrapper::after {\n    right: 0;\n    background: linear-gradient(to left, #f6f6f6 0%, transparent 100%);\n  }\n\n  .brands-ticker__track {\n    display: flex;\n    align-items: center;\n    gap: 72px;\n    width: max-content;\n    animation: ticker-scroll 32s linear infinite;\n    padding: 8px 0;\n  }\n\n  .brands-ticker__track:hover {\n    animation-play-state: paused;\n  }\n\n  .brands-ticker__item {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    transition: transform 0.3s ease, opacity 0.3s ease;\n    opacity: 0.85;\n    /* Pas de height fixe — on laisse le SVG dicter sa taille */\n  }\n\n  .brands-ticker__item:hover {\n    opacity: 1;\n    transform: scale(1.05);\n  }\n\n  .brands-ticker__item img {\n    height: var(--logo-height);\n    width: auto;\n    max-width: none;\n    display: block;\n  }\n\n  @keyframes ticker-scroll {\n    0%   { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  @media (max-width: 768px) {\n    .brands-ticker__track {\n      gap: 48px;\n      animation-duration: 22s;\n    }\n    .brands-ticker__item img {\n      height: calc(var(--logo-height) * 0.75);\n    }\n  }\n</style>\n\n<div class=\"brands-ticker\">\n  <div class=\"brands-ticker__track-wrapper\">\n    <div class=\"brands-ticker__track\">\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-trek.webp' | asset_url }}\" alt=\"Trek\" width=\"188\" height=\"24\" style=\"--logo-height: 24px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-specialized.webp' | asset_url }}\" alt=\"Specialized\" width=\"141\" height=\"58\" style=\"--logo-height: 58px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-cannondale.webp' | asset_url }}\" alt=\"Cannondale\" width=\"76\" height=\"62\" style=\"--logo-height: 62px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-canyon.webp' | asset_url }}\" alt=\"Canyon\" width=\"171\" height=\"24\" style=\"--logo-height: 24px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-kona.webp' | asset_url }}\" alt=\"Kona\" width=\"185\" height=\"26\" style=\"--logo-height: 26px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-lapierre.webp' | asset_url }}\" alt=\"Lapierre\" width=\"121\" height=\"54\" style=\"--logo-height: 54px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-origine.webp' | asset_url }}\" alt=\"Origine\" width=\"189\" height=\"20\" style=\"--logo-height: 20px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-salsa.webp' | asset_url }}\" alt=\"Salsa\" width=\"147\" height=\"38\" style=\"--logo-height: 38px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\">\n        <img src=\"{{ 'brand-open.webp' | asset_url }}\" alt=\"Open\" width=\"159\" height=\"40\" style=\"--logo-height: 40px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      {% comment %} Duplication pour la boucle infinie {% endcomment %}\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-trek.webp' | asset_url }}\" alt=\"\" width=\"188\" height=\"24\" style=\"--logo-height: 24px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-specialized.webp' | asset_url }}\" alt=\"\" width=\"141\" height=\"58\" style=\"--logo-height: 58px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-cannondale.webp' | asset_url }}\" alt=\"\" width=\"76\" height=\"62\" style=\"--logo-height: 62px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-canyon.webp' | asset_url }}\" alt=\"\" width=\"171\" height=\"24\" style=\"--logo-height: 24px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-kona.webp' | asset_url }}\" alt=\"\" width=\"185\" height=\"26\" style=\"--logo-height: 26px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-lapierre.webp' | asset_url }}\" alt=\"\" width=\"121\" height=\"54\" style=\"--logo-height: 54px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-origine.webp' | asset_url }}\" alt=\"\" width=\"189\" height=\"20\" style=\"--logo-height: 20px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-salsa.webp' | asset_url }}\" alt=\"\" width=\"147\" height=\"38\" style=\"--logo-height: 38px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n      <div class=\"brands-ticker__item\" aria-hidden=\"true\">\n        <img src=\"{{ 'brand-open.webp' | asset_url }}\" alt=\"\" width=\"159\" height=\"40\" style=\"--logo-height: 40px\" loading=\"lazy\" decoding=\"async\">\n      </div>\n\n    </div>\n  </div>\n</div>",
