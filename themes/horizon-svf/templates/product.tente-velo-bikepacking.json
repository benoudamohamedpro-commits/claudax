            "custom_code_HtaVi8": {
              "type": "custom-liquid",
              "settings": {
                "custom_liquid": "<div class=\"trust-section\">\n  <div class=\"trust-grid\">\n    <div class=\"trust-card\">\n      <div class=\"badge-number\">01</div>\n      <h3>Livraison</h3>\n      <p>Gratuite</p>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"/>\n        <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"/>\n        <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/>\n        <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/>\n      </svg>\n    </div>\n    <div class=\"trust-card\">\n      <div class=\"badge-number\">02</div>\n      <h3>Retours</h3>\n      <p>Gratuits</p>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M9 14 4 9l5-5\"/>\n        <path d=\"M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5 5.5 5.5 0 0 1-5.5 5.5H11\"/>\n      </svg>\n    </div>\n    <div class=\"trust-card\">\n      <div class=\"badge-number\">03</div>\n      <h3>Garantie</h3>\n      <p>1 An</p>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n        <path d=\"M12 12v4\"/>\n      </svg>\n    </div>\n  </div>\n</div>\n<style>\n  .trust-section {\n    margin: 1.5rem 0 1rem;\n  }\n  .trust-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 0.5rem;\n  }\n  .trust-card {\n    position: relative;\n    padding: 1.1rem 0.5rem 0.7rem;\n    border: 1px solid #e5e5e5;\n    border-radius: 8px;\n    text-align: center;\n    background: #fafafa;\n    transition: border-color 0.3s ease, background 0.3s ease;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n  .trust-card:hover {\n    border-color: #2a7f62;\n    background: #f0f7f4;\n  }\n  .badge-number {\n    position: absolute;\n    top: -10px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 20px;\n    height: 20px;\n    background: #2a7f62;\n    color: #fff;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 700;\n    font-size: 0.7rem;\n  }\n  .trust-card h3 {\n    margin: 0 0 0.1rem;\n    font-size: 0.78rem;\n    font-weight: 600;\n    color: #333;\n    line-height: 1.2;\n  }\n  .trust-card p {\n    margin: 0 0 0.4rem;\n    font-size: 0.8rem;\n    font-weight: 700;\n    color: #2a7f62;\n    line-height: 1.2;\n  }\n  .trust-card svg {\n    width: 18px;\n    height: 18px;\n    color: #2a7f62;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n  @media (max-width: 380px) {\n    .trust-grid {\n      gap: 0.35rem;\n    }\n    .trust-card {\n      padding: 1rem 0.3rem 0.6rem;\n    }\n    .trust-card h3 {\n      font-size: 0.72rem;\n    }\n    .trust-card p {\n      font-size: 0.74rem;\n    }\n  }\n</style>"
